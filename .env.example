POSTGRES_USER=cosmouser
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=cosmoquant_db
DATABASE_URL=postgresql://cosmouser:your_secure_password@db:5432/cosmoquant_db
GEMINI_API_KEY=your_gemini_api_key
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
PYTHONUNBUFFERED=1
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET=your_alpaca_secret
HF_TOKEN=your_hugging_face_token

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=CosmoQuantAI/1.0

# CryptoPanic API
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key

# SaaS Security & Deployment
ENVIRONMENT=development
FRONTEND_URL=http://localhost:2026
SECRET_KEY=replace_with_a_long_random_secret_key_min_32_chars
ENCRYPTION_KEY=replace_with_a_valid_fernet_key
BACKEND_CORS_ORIGINS=http://localhost:2026,http://127.0.0.1:2026
TRUST_PROXY_HEADERS=true

# Sole Platform Owner Bootstrap
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=replace_with_strong_owner_password
OWNER_FULL_NAME=Platform Owner

# Transactional SMTP Email
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your_smtp_api_key
SMTP_FROM=noreply@yourdomain.com
SMTP_STARTTLS=true
SMTP_SSL_TLS=false

# SaaS Billing Providers (Optional until ready for paid checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
